{
  "_comment": "文生图 SDXL 基础工作流（API 格式）。{{占位符}} 由 comfyui_api.py 渲染。checkpoint 名称需与 ComfyUI 服务端 models/checkpoints 下文件一致，可用 --checkpoint 覆盖。",
  "_defaults": {
    "checkpoint": "sd_xl_base_1.0.safetensors",
    "width": 1024,
    "height": 1024,
    "steps": 20,
    "negative": "lowres, bad anatomy, bad hands, text, error, missing fingers, extra digit, fewer digits, cropped, worst quality, low quality, jpeg artifacts, watermark",
    "cfg": 7,
    "denoise": 1,
    "prefix": "t2i"
  },
  "3": {
    "class_type": "KSampler",
    "inputs": {
      "seed": {{SEED}},
      "steps": {{STEPS}},
      "cfg": {{CFG}},
      "sampler_name": "dpmpp_2m_sde",
      "scheduler": "karras",
      "denoise": {{DENOISE}},
      "model": ["4", 0],
      "positive": ["6", 0],
      "negative": ["7", 0],
      "latent_image": ["5", 0]
    }
  },
  "4": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": { "ckpt_name": "{{CHECKPOINT}}" }
  },
  "5": {
    "class_type": "EmptyLatentImage",
    "inputs": { "width": {{WIDTH}}, "height": {{HEIGHT}}, "batch_size": 1 }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "{{PROMPT}}", "clip": ["4", 1] }
  },
  "7": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "{{NEGATIVE}}", "clip": ["4", 1] }
  },
  "8": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["3", 0], "vae": ["4", 2] }
  },
  "9": {
    "class_type": "SaveImage",
    "inputs": { "filename_prefix": "{{PREFIX}}", "images": ["8", 0] }
  }
}
