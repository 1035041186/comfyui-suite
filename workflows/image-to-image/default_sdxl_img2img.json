{
  "_comment": "图生图（含图文混合输入）SDXL 工作流。--image 上传后注入 UPLOADED_IMAGE；denoise 控制重绘幅度：0.3~0.5 微调、0.5~0.7 风格迁移、0.7~0.9 大改。",
  "_defaults": {
    "checkpoint": "sd_xl_base_1.0.safetensors",
    "steps": 20,
    "negative": "lowres, bad anatomy, bad hands, worst quality, low quality, jpeg artifacts, watermark",
    "cfg": 7,
    "denoise": 0.6,
    "prefix": "i2i"
  },
  "3": {
    "class_type": "KSampler",
    "inputs": {
      "seed": {{SEED}},
      "steps": {{STEPS}},
      "cfg": {{CFG}},
      "sampler_name": "dpmpp_2m_sde",
      "scheduler": "karras",
      "denoise": {{DENOISE}},
      "model": ["4", 0],
      "positive": ["6", 0],
      "negative": ["7", 0],
      "latent_image": ["10", 0]
    }
  },
  "4": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": { "ckpt_name": "{{CHECKPOINT}}" }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "{{PROMPT}}", "clip": ["4", 1] }
  },
  "7": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "{{NEGATIVE}}", "clip": ["4", 1] }
  },
  "8": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["3", 0], "vae": ["4", 2] }
  },
  "9": {
    "class_type": "SaveImage",
    "inputs": { "filename_prefix": "{{PREFIX}}", "images": ["8", 0] }
  },
  "10": {
    "class_type": "VAEEncode",
    "inputs": { "pixels": ["11", 0], "vae": ["4", 2] }
  },
  "11": {
    "class_type": "LoadImage",
    "inputs": { "image": "{{UPLOADED_IMAGE}}" }
  }
}
